{
  "manifest_version": 3,
  "name": "Nube Nube",
  "version": "1.0.0",
  "description": "Tells Nube Nube which site you're on, and blocks Rest sites while a focus timer runs.",
  "key": "",
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
